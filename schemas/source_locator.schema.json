{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Snapshot-relative evidence locator",
  "type": "object",
  "minProperties": 3,
  "additionalProperties": false,
  "required": ["snapshot_id", "snapshot_hash"],
  "properties": {
    "snapshot_id": {"type": "string", "minLength": 1},
    "snapshot_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "page": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1}]},
    "page_start": {"type": "integer", "minimum": 1},
    "page_end": {"type": "integer", "minimum": 1},
    "section": {"type": "string", "minLength": 1},
    "table": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1}]},
    "figure": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1}]},
    "paragraph": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1}]},
    "heading": {"type": "string", "minLength": 1},
    "document_fragment": {"type": "string", "minLength": 1},
    "quote_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "anyOf": [{"required": ["page"]}, {"required": ["page_start"]}, {"required": ["section"]}, {"required": ["table"]}, {"required": ["figure"]}, {"required": ["paragraph"]}, {"required": ["heading"]}, {"required": ["document_fragment"]}]
}
